# Datadog credentials — copy this file to .env and fill in your real keys
# NEVER commit .env to git (it is already in .gitignore)

DATADOG_API_KEY=YOUR_API_KEY
DATADOG_APP_KEY=YOUR_APP_KEY

# Datadog Site (default: datadoghq.com | options: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com)
DATADOG_SITE=datadoghq.com

# Optional overrides
NOTIFICATION_EMAIL=notify@example.com
ENV=k8s-lab
